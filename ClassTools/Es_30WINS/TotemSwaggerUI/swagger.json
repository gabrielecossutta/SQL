{
  "openapi": "3.0.1",
  "info": {
    "title": "My API",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "url": "https://localhost:82/"
    }
  ],
  "paths": {
    "/login": {
      "get": {
        "summary": "Login User",
        "description": "Basic authentication return a JWT.",
        "responses": {
          "200": {
            "description": "Login compleated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string" }
                  }
                },
                "examples": {
                  "success": {
                    "value": {
                      "token": "eyJhbGciOiJIUzI1NiIsInR5..."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Login failed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardResponse" },
                "examples": {
                  "unauthorized": {
                    "value": {
                      "status": "error",
                      "message": "Login failed"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/getallproducts": {
      "get": {
        "summary": "Retrive all the products",
        "security": [ { "bearerAuth": [] } ],
        "responses": {
          "200": {
            "description": "Product list"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/getoldorder": {
      "get": {

        "summary": "Retrive the last order",
        "security": [ { "bearerAuth": [] } ],
        "responses": {
          "200": {
            "description": "Order retrived"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/increasedetail": {
      "patch": {
        "summary": "Increase a order quantity",
        "security": [ { "bearerAuth": [] } ],
        "requestBody": { "$ref": "#/components/requestBodies/IDsBody" },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/decreasedetail": {
      "patch": {
        "summary": "Decrease a order quantity",
        "security": [ { "bearerAuth": [] } ],
        "requestBody": { "$ref": "#/components/requestBodies/IDsBody" },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/deletedetail": {
      "delete": {
        "summary": "Delete a detail",
        "security": [ { "bearerAuth": [] } ],
        "requestBody": { "$ref": "#/components/requestBodies/IDsBody" },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/deletealldetails": {
      "delete": {
        "summary": "Delete all the details of an order",
        "security": [ { "bearerAuth": [] } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeleteRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/newdetails": {
      "post": {
        "summary": "Add a new detail",
        "security": [ { "bearerAuth": [] } ],
        "requestBody": { "$ref": "#/components/requestBodies/IDsBody" },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/createorder": {
      "post": {
        "summary": "Create an order",
        "security": [ { "bearerAuth": [] } ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "StandardResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "IDs": {
        "type": "object",
        "properties": {
          "IdOrder": { "type": "integer" },
          "IdProduct": { "type": "integer" }
        },
        "required": [ "IdOrder", "IdProduct" ]
      },
      "DeleteRequest": {
        "type": "object",
        "properties": {
          "IdOrder": { "type": "integer" }
        },
        "required": [ "IdOrder" ]
      }
    },
    "requestBodies": {
      "IDsBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/IDs" }
          }
        }
      }
    },
    "responses": {
      "Success": {
        "description": "Operation completed",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/StandardResponse" },
            "examples": {
              "success": {
                "value": {
                  "status": "success",
                  "message": "Operation completed"
                }
              }
            }
          }
        }
      },
      "Error": {
        "description": "Error in the elaboration",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/StandardResponse" },
            "examples": {
              "error": {
                "value": {
                  "status": "error",
                  "message": "Operation failed"
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Token invalid or empty",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/StandardResponse" },
            "examples": {
              "unauthorized": {
                "value": {
                  "status": "error",
                  "message": "Token JWT invalid or empty"
                }
              }
            }
          }
        }
      }
    }
  }
}
