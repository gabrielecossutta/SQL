	<DataSets>
		<DataSet Name="DataSet1">
			<Fields>
				<Field Name="IdProduct">
					<DataField>IdProduct</DataField>
				</Field>
				<Field Name="RegistrationDate">
					<DataField>RegistrationDate</DataField>
				</Field>
				<Field Name="TotalQuantity">
					<DataField>TotalQuantity</DataField>
				</Field>
				<Field Name="TotalPrice">
					<DataField>TotalPrice</DataField>
				</Field>
			</Fields>
			<Query>
				<CommandText>SELECT * FROM Summaries
WHERE Summaries.RegistrationDate &gt;= @StartDate And Summaries.RegistrationDate &lt;= @EndDate</CommandText>
				<DataSourceName>DataSource1</DataSourceName>
				<QueryParameters>
					<QueryParameter Name="EndDate">
						<Value>=Parameters!EndDate.Value</Value>
					</QueryParameter>
					<QueryParameter Name="StartDate">
						<Value>=Parameters!StartDate.Value</Value>
					</QueryParameter>
				</QueryParameters>
			</Query>
